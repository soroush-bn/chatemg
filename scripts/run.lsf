#!/bin/bash

set -euo pipefail

module purge
module load miniconda/pytorch-tensorflow-gpu-2024.09

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate buildrust
python -m pip install --user tiktoken
python -m pip install --user seaborn
python -m pip install --user wandb==0.15.11
export WANDB_API_KEY=$(cat ~/.wandb_key)


export PYTHONUNBUFFERED=1
python prepare_data_for_train.py

# Get number of GPUs available
NUM_GPUS=$(nvidia-smi --query-gpu=name --format=csv,noheader | wc -l)
echo "Number of GPUs detected: $NUM_GPUS"

# Start background GPU monitoring
echo "Starting GPU monitoring (logging to gpu_usage_log.csv)..."
(
    while true; do
        nvidia-smi --query-gpu=index,timestamp,utilization.gpu,utilization.memory,memory.used,memory.total,temperature.gpu,power.draw \
                   --format=csv >> gpu_usage_log.csv
        sleep 10  # Log every 10 seconds
    done
) &
GPU_MONITOR_PID=$!

# Trap to ensure GPU monitoring stops when script exits
trap "kill $GPU_MONITOR_PID 2>/dev/null" EXIT

# Launch distributed training with torchrun if multiple GPUs, otherwise single GPU
if [ "$NUM_GPUS" -gt 1 ]; then
    echo "Launching distributed training on $NUM_GPUS GPUs"
    torchrun --standalone --nproc_per_node=$NUM_GPUS train.py 
else
    echo "Launching single GPU training"
    python -u train.py 
fi
# Echo git branch and commit information
echo "Git Branch: $(git rev-parse --abbrev-ref HEAD)"
echo "Git Commit: $(git rev-parse HEAD)"
echo "Git Commit (short): $(git rev-parse --short HEAD)"

# Stop GPU monitoring
kill $GPU_MONITOR_PID 2>/dev/null
echo "GPU usage log saved to gpu_usage_log.csv"

python sample.py 
